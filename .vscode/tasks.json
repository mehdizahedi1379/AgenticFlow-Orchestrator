{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Install Dependencies (npm install)",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "2. Start Dev Server (npm run dev)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "3. Build Web & Backend (npm run build)",
      "type": "shell",
      "command": "npm run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "4. Build Real Windows .EXE (Electron Builder)",
      "type": "shell",
      "command": "npx electron-builder --win nsis",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "5. Run Portable Agent (Node Daemon)",
      "type": "shell",
      "command": "node public/downloads/nexus-agent-daemon.mjs",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
